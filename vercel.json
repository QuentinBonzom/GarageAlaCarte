{
  "redirects": [
    {
      "source": "/projects",
      "destination": "/projects/",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/conditions",
      "destination": "/conditions/",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": true
    },
    {
      "source": "/services/garage-design-blueprint-orlando",
      "destination": "/services/garage-design-blueprint-orlando/",
      "permanent": true
    },
    {
      "source": "/services/garage-design-setup-orlando",
      "destination": "/services/garage-design-setup-orlando/",
      "permanent": true
    },
    {
      "source": "/services/full-garage-transformation-orlando",
      "destination": "/services/full-garage-transformation-orlando/",
      "permanent": true
    },
    {
      "source": "/services/smart-garage-integration-orlando",
      "destination": "/services/smart-garage-integration-orlando/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/admin/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
